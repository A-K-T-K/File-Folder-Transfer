{
  "name": "file-folder-transfer",
  "version": "0.0.1",
  "description": "Fast and standalone local file and folder transfer server with native desktop support.",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "tauri dev",
    "prebuild": "node scripts/patch-portable-icon.js",
    "build": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --output dist/File-Folder-Transfer",
    "portable": "node scripts/build-portable.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "open": "^8.4.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "pkg": "^5.8.1",
    "rcedit": "^5.0.2"
  },
  "pkg": {
    "assets": [
      "index.html",
      "server.html",
      "icon.svg",
      "fluent-components.min.js"
    ],
    "outputPath": "dist"
  }
}
